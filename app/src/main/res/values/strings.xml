<!--
    Default strings (English). Every language without its own values-xx/ folder
    falls back to this file, so the app stays usable worldwide before it is
    translated. Spanish lives in values-es/.
    To add a language: copy this file to res/values-<code>/, translate the
    values without touching the names, and add its <locale> to
    res/xml/locales_config.xml. Exercise names are in strings_exercises.xml.
-->
